# העתק קובץ זה ל-.env ומלא את הערכים האמיתיים (נמצאים ב-Supabase Dashboard > Project Settings > API).
# בלי הקובץ הזה האפליקציה קורסת מיד עם שגיאת "supabaseUrl is required" - זה בדיוק
# מה שגרם למסך השחור בבנייה הראשונה של אפליקציית ה-iOS (ה-.env לא מגיע ב-git clone,
# כי הוא ב-.gitignore בכוונה - אלה לא סודות רגישים, אבל אין טעם לגרסן אותם).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
