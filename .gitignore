# Dependencies
node_modules

# Build output
dist

# Local Netlify folder
.netlify

# Local Supabase CLI state (project link, cached tokens)
supabase/.temp

# Environment secrets
.env
.env.local
.env.*.local

# Editor / OS junk
.DS_Store
Thumbs.db

# iOS native project (Capacitor) - keep the Xcode project itself,
# ignore generated/user-local files that get recreated on each build.
ios/App/App/public
ios/App/Pods
ios/App/output
ios/App/.xcode.env.local
**/xcuserdata/
**/*.xcuserstate

# חומר חתימה פרטי (מפתח/CSR/תעודות) - אף פעם לא נכנס לגיט
.signing_tmp/
